{
  "name": "openclaw-watches",
  "version": "0.1.3",
  "description": "Ephemeral model, URL, and GitHub PR watches for OpenClaw.",
  "license": "MIT",
  "files": [
    "dist/**",
    "api.ts",
    "index.ts",
    "openclaw.plugin.json",
    "src",
    "examples",
    ".github/ISSUE_TEMPLATE",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "typebox": "1.1.38"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.5.10-beta.1",
      "minGatewayVersion": "2026.5.10-beta.1"
    },
    "release": {
      "publishToNpm": false
    }
  }
}
